#!/usr/bin/env python3
"""phone: lets Claude see and control an Android device over ADB.

Part of Fun Installer (see README.md). Run `phone -h` for the command list.
Only the Python 3 standard library is used, plus the `adb` and `curl` tools.

Safety built into this tool (not just into Claude's instructions):
  * It never reads, taps or types into Termux (the terminal Claude runs in),
    so Claude can't answer its own approval prompts.
  * It refuses to read, screenshot or control apps in config/blocked-apps.txt.
  * Tapping by index needs a fresh `phone screen` after every action, so it
    never taps based on an out-of-date view of the screen.
"""
from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import zipfile
import xml.etree.ElementTree as ET
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from urllib.parse import urlparse

REPO = Path(__file__).resolve().parent.parent
ADB = os.environ.get("PHONE_ADB", "adb")
STATE = Path(os.environ.get("PHONE_STATE_DIR") or Path.home() / ".cache" / "fun-installer")
DOWNLOADS = Path(os.environ.get("PHONE_DOWNLOADS") or REPO / "downloads")
SCREENS = Path(os.environ.get("PHONE_SCREENS") or REPO / "screens")
BLOCKLIST = REPO / "config" / "blocked-apps.txt"
LAST = STATE / "last-screen.json"
SERIAL_FILE = STATE / "serial"
REMOTE_DUMP = "/data/local/tmp/fun-installer-ui.xml"
TERMUX_PKG = "com.termux"
TERMUX_ACTIVITY = "com.termux/com.termux.app.TermuxActivity"
ALWAYS_BLOCKED = ["com.termux", "com.termux.*"]
SETTLE = float(os.environ.get("PHONE_SETTLE", "0.6"))
STALE_AFTER = 600  # seconds before a saved screen is too old to tap by index
PUSH_ROOTS = ("/sdcard/", "/storage/emulated/0/", "/storage/self/primary/", "/data/local/tmp/")

KEYS = {
    "back": 4, "home": 3, "enter": 66, "recents": 187, "apps": 187, "tab": 61,
    "del": 67, "backspace": 67, "delete": 112, "space": 62, "up": 19, "down": 20,
    "left": 21, "right": 22, "center": 23, "menu": 82, "search": 84, "escape": 111,
    "esc": 111, "volume_up": 24, "volume_down": 25, "page_up": 92, "page_down": 93,
    "move_home": 122, "move_end": 123,
}


class PhoneError(Exception):
    def __init__(self, msg: str, code: int = 1):
        super().__init__(msg)
        self.code = code


def die(msg: str, code: int = 1):
    raise PhoneError(msg, code)


# --------------------------------------------------------------------------- adb

_serial: str | None = None


def run(args, *, timeout=60, binary=False, check=True, use_serial=True):
    cmd = [ADB] + (["-s", device_serial()] if use_serial else []) + [str(a) for a in args]
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=timeout, text=not binary)
    except FileNotFoundError:
        die(f"'{ADB}' not found. Run setup/setup.sh first (it installs adb).")
    except subprocess.TimeoutExpired:
        die(f"adb timed out after {timeout}s: {' '.join(map(str, args))[:100]}")
    if check and r.returncode != 0:
        err = r.stderr.decode(errors="replace") if binary else r.stderr
        out = "" if binary else r.stdout
        die(f"adb {args[0]} failed: {(err or out).strip() or 'exit code %d' % r.returncode}")
    return r


def sh(command: str, **kw):
    """Run a command string in the device's shell. Quote pieces with q()."""
    return run(["shell", command], **kw)


def q(*parts) -> str:
    return " ".join(shlex.quote(str(p)) for p in parts)


def list_devices():
    r = run(["devices"], use_serial=False, timeout=20, check=False)
    devs = []
    for line in r.stdout.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 2:
            devs.append((parts[0], parts[1]))
    return devs


def device_serial() -> str:
    global _serial
    if _serial:
        return _serial
    if os.environ.get("ANDROID_SERIAL"):
        _serial = os.environ["ANDROID_SERIAL"]
        return _serial
    devs = list_devices()
    ready = [s for s, st in devs if st == "device"]
    if not ready:
        seen = ", ".join(f"{s} ({st})" for s, st in devs)
        die("No device connected." + (f" Found: {seen}." if seen else "") + " Run: phone connect")
    saved = SERIAL_FILE.read_text().strip() if SERIAL_FILE.exists() else ""
    if saved in ready:
        _serial = saved
    else:
        local = [s for s in ready if s.startswith(("localhost:", "127.0.0.1:"))]
        _serial = (local or ready)[0]
    return _serial


def foreground():
    """Return (package, activity) of the app in front, or (None, None)."""
    pat = re.compile(r"\b([A-Za-z]\w*(?:\.\w+)+)/([\w.$]+)")
    for cmd in ("dumpsys window | grep -E 'mCurrentFocus|mFocusedApp'",
                "dumpsys activity activities | grep -E 'ResumedActivity'"):
        r = sh(cmd, check=False, timeout=20)
        for line in r.stdout.splitlines():
            m = pat.search(line)
            if m:
                return m.group(1), m.group(2)
    return None, None


# ---------------------------------------------------------------------- safety

def blocklist():
    pats = list(ALWAYS_BLOCKED)
    if BLOCKLIST.exists():
        for line in BLOCKLIST.read_text().splitlines():
            line = line.split("#", 1)[0].strip().lower()
            if line:
                pats.append(line)
    return pats


def block_reason(pkg: str | None, action: str = "control") -> str | None:
    if not pkg:
        return None
    p = pkg.lower()
    if p == TERMUX_PKG or p.startswith(TERMUX_PKG + "."):
        return ("The app in front is Termux (the terminal Claude runs in). Fun Installer never "
                "reads, taps or types into its own terminal. Open the app you want first: "
                "phone open <package>")
    if any(fnmatch.fnmatch(p, pat) for pat in blocklist()):
        return (f"{pkg} is on the blocked list (config/blocked-apps.txt), so Fun Installer won't "
                f"{action} it. Ask the user to do this part themselves.")
    return None


def guard(action="control", pkg=None):
    if pkg is None:
        pkg, _ = foreground()
    reason = block_reason(pkg, action)
    if reason:
        die(reason)
    return pkg


# ---------------------------------------------------------------------- screen

BOUNDS = re.compile(r"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]")


def clean(s: str | None, limit=100) -> str:
    s = " ".join((s or "").split())
    return s if len(s) <= limit else s[: limit - 1] + "…"


def dump_xml() -> str:
    last = "no output"
    for _ in range(4):
        r = sh(f"uiautomator dump {REMOTE_DUMP}", check=False, timeout=40)
        out = (r.stdout or "") + (r.stderr or "")
        if "dumped to" in out:
            x = run(["exec-out", "cat", REMOTE_DUMP], binary=True, check=False).stdout
            x = x.decode("utf-8", "replace")
            if "<hierarchy" in x:
                return x[x.index("<hierarchy"):]
        if out.strip():
            last = out.strip().splitlines()[-1]
        time.sleep(0.8)
    die(f"Couldn't read the screen ({last}). It may be animating or playing video. "
        "Wait a moment and retry, or use: phone shot")


def parse(xml_text: str) -> dict:
    root = ET.fromstring(xml_text)
    items, pkgs = [], {}
    box = [10**9, 10**9, 0, 0]

    def descendant_labels(el, exclude):
        found = []
        for d in el.iter("node"):
            if d is el:
                continue
            for t in (clean(d.get("text")), clean(d.get("content-desc"))):
                if t and t != exclude and t not in found:
                    found.append(t)
            if len(found) >= 4:
                break
        return found

    def walk(el, covered):
        for child in el:
            if child.tag != "node":
                walk(child, covered)
                continue
            a = child.attrib
            m = BOUNDS.fullmatch(a.get("bounds", ""))
            next_covered = covered
            if m:
                x1, y1, x2, y2 = map(int, m.groups())
                pkg = a.get("package", "")
                if pkg:
                    pkgs[pkg] = pkgs.get(pkg, 0) + 1
                if x2 > x1 and y2 > y1:
                    box[0], box[1] = min(box[0], x1), min(box[1], y1)
                    box[2], box[3] = max(box[2], x2), max(box[3], y2)
                    on = lambda k: a.get(k) == "true"  # noqa: E731
                    cls = a.get("class", "").rsplit(".", 1)[-1]
                    text, desc = clean(a.get("text")), clean(a.get("content-desc"))
                    hint = clean(a.get("hint"))
                    label = text or desc
                    if text and desc and desc != text:
                        label = f"{text} | {desc}"
                    clickable, long_ = on("clickable"), on("long-clickable")
                    scrollable, checkable = on("scrollable"), on("checkable")
                    editable = "EditText" in cls or "AutoCompleteTextView" in cls
                    interactive = clickable or long_ or scrollable or checkable or editable
                    subs = descendant_labels(child, label) if interactive and not scrollable else []
                    if interactive or (label and not covered):
                        flags = []
                        if clickable:
                            flags.append("tap")
                        if long_:
                            flags.append("long")
                        if scrollable:
                            flags.append("scroll")
                        if editable:
                            flags.append("edit")
                        if checkable:
                            flags.append("on" if on("checked") else "off")
                        for f in ("focused", "selected", "password"):
                            if on(f):
                                flags.append(f)
                        if a.get("enabled") == "false":
                            flags.append("disabled")
                        rid = a.get("resource-id", "")
                        items.append({
                            "cls": cls, "label": label, "hint": hint if hint != label else "",
                            "subs": subs, "id": rid.split("/", 1)[-1] if rid else "", "pkg": pkg,
                            "x1": x1, "y1": y1, "x2": x2, "y2": y2,
                            "cx": (x1 + x2) // 2, "cy": (y1 + y2) // 2, "flags": flags,
                        })
                    if (clickable or long_) and not scrollable and (label or subs):
                        next_covered = True
            walk(child, next_covered)

    walk(root, False)
    for i, it in enumerate(items):
        it["i"] = i
    main = max(pkgs, key=pkgs.get) if pkgs else ""
    if box[2] == 0:
        box = [0, 0, 0, 0]
    return {"pkg": main, "pkgs": sorted(pkgs), "box": box, "items": items}


def render(scr: dict) -> str:
    x1, y1, x2, y2 = scr["box"]
    others = [p for p in scr["pkgs"] if p != scr["pkg"]]
    head = f"App: {scr['pkg'] or '?'}"
    if others:
        head += f"  (also on screen: {', '.join(others)})"
    head += f"  | area {x1},{y1} to {x2},{y2}"
    lines = [head]
    if scr.get("warning"):
        lines.insert(0, scr["warning"])
    if scr.get("blocked"):
        lines.append(f"(not shown) {scr['blocked']}")
        return "\n".join(lines)
    for it in scr["items"]:
        s = f"[{it['i']}] {it['cls'] or 'View'}"
        if it["label"]:
            s += f' "{it["label"]}"'
        if it.get("hint"):
            s += f' hint="{it["hint"]}"'
        if it["subs"]:
            s += " > " + " / ".join(f'"{t}"' for t in it["subs"])
        if it["id"]:
            s += f" #{it['id']}"
        s += f" @{it['cx']},{it['cy']}"
        if it["flags"]:
            s += " [" + ",".join(it["flags"]) + "]"
        lines.append(s)
    if not scr["items"]:
        lines.append("(no readable elements: probably a game, video, image or custom-drawn screen. "
                     "Use: phone shot)")
    return "\n".join(lines)


def save_screen(scr: dict):
    STATE.mkdir(parents=True, exist_ok=True)
    LAST.write_text(json.dumps(dict(scr, time=time.time(), stale=None)))


def load_screen() -> dict:
    if not LAST.exists():
        die("No saved screen yet. Run: phone screen")
    return json.loads(LAST.read_text())


def mark_stale(action: str):
    if LAST.exists():
        try:
            d = json.loads(LAST.read_text())
            d["stale"] = action
            LAST.write_text(json.dumps(d))
        except (OSError, ValueError):
            pass


RECENT = STATE / "recent-screens.json"


def loop_warning(scr: dict) -> str | None:
    """Remember recent screens; warn when the same one or two keep coming back."""
    sig = hashlib.sha1((scr["pkg"] + "|" + "|".join(
        it["label"] + "/".join(it["subs"]) for it in scr["items"])).encode()).hexdigest()[:12]
    try:
        recent = json.loads(RECENT.read_text()) if RECENT.exists() else []
    except (OSError, ValueError):
        recent = []
    now = time.time()
    recent = [r for r in recent if now - r.get("t", 0) < 900][-11:] + [{"s": sig, "t": now}]
    STATE.mkdir(parents=True, exist_ok=True)
    RECENT.write_text(json.dumps(recent))
    last = [r["s"] for r in recent[-8:]]
    if len(last) >= 6 and len(set(last)) <= 2:
        return (f"WARNING: you are going in circles: the last {len(last)} screens were the same "
                f"{len(set(last))} screen(s). Stop and change approach (for files, use phone download / "
                "unpack / push instead of a file manager). If still stuck, run phone termux and ask the user.")
    return None


def read_screen(track: bool = True) -> dict:
    scr = parse(dump_xml())
    scr["blocked"] = block_reason(scr["pkg"], "read")
    if scr["blocked"]:
        scr["items"] = []
    scr["warning"] = loop_warning(scr) if track else None
    save_screen(scr)
    return scr


def find(items, query: str):
    ql = query.lower().strip()

    def texts(it):
        return [t for t in [it["label"], it.get("hint", ""), it["id"], *it["subs"]] if t]

    def prefer_interactive(hits):
        inter = [h for h in hits if set(h["flags"]) & {"tap", "long", "edit", "on", "off"}]
        return inter if len(inter) == 1 else hits

    exact = [it for it in items if any(t.lower() == ql for t in texts(it))]
    if exact:
        return prefer_interactive(exact)
    return prefer_interactive([it for it in items if any(ql in t.lower() for t in texts(it))])


def screen_box():
    if LAST.exists():
        d = json.loads(LAST.read_text())
        if d.get("box") and d["box"][2] and time.time() - d.get("time", 0) < 3600:
            return d["box"]
    w, h = display_size()
    return [0, 0, w, h]


def display_size():
    f = STATE / "shot-size.json"
    if f.exists():
        d = json.loads(f.read_text())
        if time.time() - d.get("time", 0) < 3600:
            return d["w"], d["h"]
    out = sh("wm size", check=False).stdout
    sizes = re.findall(r"(\d+)x(\d+)", out)
    w, h = map(int, sizes[-1]) if sizes else (1080, 1920)
    rot = sh("dumpsys input | grep -m1 SurfaceOrientation", check=False).stdout
    if re.search(r"SurfaceOrientation:\s*[13]", rot):
        w, h = h, w
    return w, h


# -------------------------------------------------------------------- commands

def cmd_status(a):
    devs = list_devices()
    if not any(st == "device" for _, st in devs):
        seen = ", ".join(f"{s} ({st})" for s, st in devs)
        print("Not connected." + (f" Found: {seen}." if seen else "") + " Run: phone connect")
        return 1
    props = sh("getprop ro.product.manufacturer; getprop ro.product.model; "
               "getprop ro.build.version.release; getprop ro.build.version.sdk").stdout.split("\n")
    props = (props + [""] * 4)[:4]
    pkg, _ = foreground()
    print(f"Connected: {device_serial()}")
    print(f"Device: {props[0].strip()} {props[1].strip()}, Android {props[2].strip()} (SDK {props[3].strip()})")
    print(f"In front: {pkg or 'unknown'}")
    return 0


def cmd_info(a):
    keys = ["ro.product.manufacturer", "ro.product.model", "ro.build.version.release",
            "ro.build.version.sdk", "ro.product.cpu.abi", "ro.product.cpu.abilist"]
    vals = sh("; ".join(f"getprop {k}" for k in keys)).stdout.split("\n")
    vals = [v.strip() for v in (vals + [""] * len(keys))[: len(keys)]]
    size = sh("wm size; wm density", check=False).stdout.strip().replace("\n", "; ")
    df = sh("df -h /sdcard | tail -1", check=False).stdout.split()
    free = f"{df[3]} free of {df[1]}" if len(df) >= 4 else "unknown"
    pkg, _ = foreground()
    print(f"Device: {vals[0]} {vals[1]}")
    print(f"Android: {vals[2]} (SDK {vals[3]})")
    print(f"CPU type (ABI): {vals[4]}  (supports: {vals[5]})")
    print(f"Display: {size}")
    print(f"Storage: {free}")
    print(f"In front: {pkg or 'unknown'}")


def cmd_pair(a):
    if len(a.args) == 1:
        port, code = None, a.args[0]
    elif len(a.args) == 2:
        port, code = a.args
    else:
        die("Usage: phone pair <code>   (or: phone pair <port> <code>)")
    if not re.fullmatch(r"\d{6}", code):
        die("The pairing code is the 6-digit number in the 'Pair device with pairing code' dialog.")
    if port:
        targets = [port if ":" in port else f"localhost:{port}"]
    else:
        targets = []
        r = run(["mdns", "services"], use_serial=False, check=False, timeout=10)
        for line in r.stdout.splitlines():
            m = re.search(r"_adb-tls-pairing\S*\s+(\d+\.\d+\.\d+\.\d+):(\d+)", line)
            if m:
                targets.append(f"localhost:{m.group(2)}")
        if not targets:
            print("Looking for the pairing port…", flush=True)
            targets = [f"localhost:{p}" for p in _scan(30000, 61000)]
    last = ""
    for target in dict.fromkeys(targets):
        r = run(["pair", target, code], use_serial=False, check=False, timeout=15)
        out = (r.stdout + r.stderr).strip()
        if "Successfully paired" in out:
            print(f"Paired with {target}. Now run: phone connect")
            return
        last = out or last
    die("Pairing failed" + (f" ({last.splitlines()[-1]})" if last else "") + ". Keep the 'Pair device with "
        "pairing code' dialog open (use split screen) and type the code it shows right now.")


def _try_connect(target: str):
    r = run(["connect", target], use_serial=False, check=False, timeout=15)
    out = (r.stdout + r.stderr).strip()
    low = out.lower()
    if "connected to" not in low or "failed" in low or "cannot" in low:
        return False, out
    for _ in range(6):
        states = dict(list_devices())
        if states.get(target) == "device":
            return True, out
        time.sleep(0.5)
    return False, f"{out} (state: {dict(list_devices()).get(target, 'missing')})"


def _connected(target: str):
    STATE.mkdir(parents=True, exist_ok=True)
    SERIAL_FILE.write_text(target)
    print(f"Connected to {target}")


def _scan(lo, hi):
    def probe(p):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(0.3)
            return p if s.connect_ex(("127.0.0.1", p)) == 0 else None
    with ThreadPoolExecutor(max_workers=256) as ex:
        return [p for p in ex.map(probe, range(lo, hi + 1)) if p and p != 5037]


def cmd_connect(a):
    if a.port:
        target = a.port if ":" in a.port else f"localhost:{a.port}"
        ok, out = _try_connect(target)
        if not ok:
            die(f"{out}\nIf you've never paired this device, pair first: phone pair <code>")
        _connected(target)
        return
    ready = [s for s, st in list_devices() if st == "device"]
    if ready:
        print(f"Already connected: {', '.join(ready)}")
        return
    tried = []
    if SERIAL_FILE.exists():
        tried.append(SERIAL_FILE.read_text().strip())
    r = run(["mdns", "services"], use_serial=False, check=False, timeout=10)
    for line in r.stdout.splitlines():
        m = re.search(r"_adb-tls-connect\S*\s+(\d+\.\d+\.\d+\.\d+):(\d+)", line)
        if m:
            tried += [f"localhost:{m.group(2)}", f"{m.group(1)}:{m.group(2)}"]
    for t in dict.fromkeys(tried):
        if t and _try_connect(t)[0]:
            return _connected(t)
    print("Looking for the wireless debugging port…", flush=True)
    for port in _scan(30000, 61000) + [5555]:
        if _try_connect(f"localhost:{port}")[0]:
            return _connected(f"localhost:{port}")
    die("Couldn't find the wireless debugging port.\n"
        "1. Wi-Fi must be on, and Settings > Developer options > Wireless debugging must be ON.\n"
        "2. Never paired? Tap 'Pair device with pairing code', then run: phone pair <code>\n"
        "3. Or give the port shown under 'IP address & Port': phone connect <port>")


def cmd_screen(a):
    scr = read_screen()
    print(render(scr))


def cmd_shot(a):
    guard("screenshot")
    data = run(["exec-out", "screencap", "-p"], binary=True, timeout=60).stdout
    if not data.startswith(b"\x89PNG"):
        die("Screenshot failed (the app may block screenshots).")
    SCREENS.mkdir(parents=True, exist_ok=True)
    path = Path(a.out) if a.out else SCREENS / time.strftime("shot-%Y%m%d-%H%M%S.png")
    path.write_bytes(data)
    w = int.from_bytes(data[16:20], "big")
    h = int.from_bytes(data[20:24], "big")
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / "shot-size.json").write_text(json.dumps({"w": w, "h": h, "time": time.time()}))
    print(f"Saved: {path}\nScreen size: {w}x{h} pixels. To tap something you see in it, use "
          f"percentages: phone tap --pct <x%> <y%>")


def _tap_xy(x, y, long_press=False):
    if long_press:
        sh(f"input swipe {x} {y} {x} {y} 900")
    else:
        sh(f"input tap {x} {y}")


def _is_int(s):
    return re.fullmatch(r"-?\d+", s) is not None


def _is_num(s):
    return re.fullmatch(r"-?\d+(\.\d+)?", s) is not None


def cmd_tap(a):
    t = a.target
    if a.pct:
        if len(t) != 2 or not all(_is_num(v) for v in t):
            die("Usage: phone tap --pct <x%> <y%>   e.g. phone tap --pct 50 85")
        guard()
        w, h = display_size()
        x, y = int(w * float(t[0]) / 100), int(h * float(t[1]) / 100)
        what = f"{t[0]}%,{t[1]}% = ({x},{y})"
    elif len(t) == 2 and all(_is_int(v) for v in t):
        guard()
        x, y = int(t[0]), int(t[1])
        what = f"({x},{y})"
    elif len(t) == 1 and _is_int(t[0]):
        d = load_screen()
        if d.get("stale"):
            die(f"The screen may have changed since your last `phone screen` "
                f"(you ran `{d['stale']}` after it). Run `phone screen` and use the new numbers.")
        if time.time() - d.get("time", 0) > STALE_AFTER:
            die("The saved screen is more than 10 minutes old. Run `phone screen` first.")
        idx = int(t[0])
        if not 0 <= idx < len(d["items"]):
            die(f"No element [{idx}] on the last screen (it has {len(d['items'])}).")
        guard()
        it = d["items"][idx]
        x, y = it["cx"], it["cy"]
        what = f"[{idx}] \"{it['label'] or ' / '.join(it['subs']) or it['cls']}\" at ({x},{y})"
        if "disabled" in it["flags"]:
            print("note: that element is disabled, so the tap may do nothing.")
    else:
        query = " ".join(t)
        scr = read_screen()
        if scr.get("blocked"):
            die(scr["blocked"])
        hits = find(scr["items"], query)
        if not hits:
            die(f'Nothing matching "{query}" on screen. Look at `phone screen`, or scroll to find it.')
        if a.nth:
            if not 1 <= a.nth <= len(hits):
                die(f"--nth must be between 1 and {len(hits)}")
            hits = [hits[a.nth - 1]]
        if len(hits) > 1:
            listing = "\n".join(render({**scr, "items": hits, "blocked": None}).splitlines()[1:])
            die(f'{len(hits)} elements match "{query}". Tap one by its number '
                f"(these numbers are valid now):\n{listing}", code=2)
        it = hits[0]
        x, y = it["cx"], it["cy"]
        what = f"[{it['i']}] \"{it['label'] or ' / '.join(it['subs']) or it['cls']}\" at ({x},{y})"
    _tap_xy(x, y, a.long)
    mark_stale("phone tap")
    time.sleep(SETTLE)
    print(("Long-pressed " if a.long else "Tapped ") + what)


def cmd_type(a):
    text = " ".join(a.text)
    bad = sorted({c for c in text if not (32 <= ord(c) <= 126)})
    if bad:
        die(f"`phone type` can only type plain English keyboard characters (not {''.join(bad)!r}). "
            "Ask the user to type that part.")
    guard("type into")
    if a.clear:
        sh("input keyevent KEYCODE_MOVE_END; input keyevent " + " ".join(["KEYCODE_DEL"] * 80))
    if text:
        sh("input text " + shlex.quote(text.replace(" ", "%s")))
    if a.enter:
        sh("input keyevent 66")
    mark_stale("phone type")
    time.sleep(SETTLE / 2)
    print(f"Typed {len(text)} characters" + (" and pressed Enter" if a.enter else ""))


def cmd_key(a):
    codes = []
    for k in a.keys:
        kl = k.lower()
        if kl in KEYS:
            codes.append(str(KEYS[kl]))
        elif _is_int(k) or re.fullmatch(r"KEYCODE_[A-Z0-9_]+", k):
            if k in ("26", "KEYCODE_POWER", "223", "KEYCODE_SLEEP"):
                die("Power/sleep keys are not allowed (they would lock the tablet).")
            codes.append(k)
        else:
            die(f"Unknown key '{k}'. Known: {', '.join(sorted(KEYS))}, or a KEYCODE_ name.")
    if not (len(a.keys) == 1 and a.keys[0].lower() == "home"):
        guard("send keys to")
    sh("input keyevent " + " ".join(codes))
    mark_stale("phone key")
    time.sleep(SETTLE)
    print("Pressed " + " ".join(a.keys))


def cmd_scroll(a):
    guard("scroll")
    if a.at is not None:
        d = load_screen()
        if d.get("stale"):
            die("Run `phone screen` first; the element numbers are out of date.")
        if not 0 <= a.at < len(d["items"]):
            die(f"No element [{a.at}] on the last screen.")
        it = d["items"][a.at]
        x1, y1, x2, y2 = it["x1"], it["y1"], it["x2"], it["y2"]
    else:
        x1, y1, x2, y2 = screen_box()
    cx, cy = (x1 + x2) // 2, (y1 + y2) // 2
    f = max(0.05, min(a.amount, 1.0)) * 0.35
    dx, dy = int((x2 - x1) * f), int((y2 - y1) * f)
    start, end = {
        "down": ((cx, cy + dy), (cx, cy - dy)),
        "up": ((cx, cy - dy), (cx, cy + dy)),
        "right": ((cx + dx, cy), (cx - dx, cy)),
        "left": ((cx - dx, cy), (cx + dx, cy)),
    }[a.direction]
    sh(f"input swipe {start[0]} {start[1]} {end[0]} {end[1]} 400")
    mark_stale("phone scroll")
    time.sleep(SETTLE)
    print(f"Scrolled {a.direction}")


def cmd_swipe(a):
    guard("swipe in")
    x1, y1, x2, y2 = a.coords
    sh(f"input swipe {x1} {y1} {x2} {y2} {a.ms}")
    mark_stale("phone swipe")
    time.sleep(SETTLE)
    print(f"Swiped ({x1},{y1}) -> ({x2},{y2})")


def cmd_wait(a):
    deadline = time.time() + a.timeout
    while True:
        scr = read_screen(track=False)
        hits = [] if scr.get("blocked") else find(scr["items"], a.text)
        done = (not hits) if a.gone else bool(hits)
        if done:
            print(render(scr))
            print(f'\n"{a.text}" ' + ("is gone." if a.gone else "is on screen."))
            return
        if time.time() > deadline:
            print(render(scr))
            die(f'Timed out after {a.timeout}s waiting for "{a.text}"'
                + (" to disappear." if a.gone else " to appear."))
        time.sleep(1.0)


def cmd_open(a):
    reason = block_reason(a.package, "open")
    if reason:
        die(reason)
    r = sh(q("monkey", "-p", a.package, "-c", "android.intent.category.LAUNCHER", "1"),
           check=False, timeout=30)
    if "Events injected" not in (r.stdout + r.stderr):
        r2 = sh(q("cmd", "package", "resolve-activity", "--brief", "-c",
                  "android.intent.category.LAUNCHER", a.package), check=False)
        comp = (r2.stdout.strip().splitlines() or [""])[-1]
        if "/" not in comp:
            die(f"Couldn't open {a.package}. Is it installed? Check: phone apps {a.package.split('.')[-1]}")
        sh(q("am", "start", "-n", comp))
    mark_stale("phone open")
    time.sleep(1.5)
    print(f"Opened {a.package}")


def cmd_url(a):
    scheme = urlparse(a.url).scheme.lower()
    if scheme not in ("http", "https", "market"):
        die("Only http(s):// and market:// links can be opened.")
    sh(q("am", "start", "-a", "android.intent.action.VIEW", "-d", a.url))
    mark_stale("phone url")
    time.sleep(1.5)
    print(f"Opened {a.url}")


def packages(third_party=True):
    r = sh("pm list packages" + (" -3" if third_party else ""), check=False, timeout=30)
    return sorted(l.split(":", 1)[1].strip() for l in r.stdout.splitlines() if l.startswith("package:"))


def cmd_apps(a):
    pk = packages(third_party=not a.all)
    if a.filter:
        pk = [p for p in pk if a.filter.lower() in p.lower()]
    print("\n".join(pk) if pk else "(no matching apps)")


def cmd_app(a):
    out = sh(q("dumpsys", "package", a.package), check=False, timeout=30).stdout
    if f"Package [{a.package}]" not in out:
        die(f"{a.package} is not installed.")
    print(f"Package: {a.package}")
    for key in ("versionName", "versionCode", "targetSdk", "firstInstallTime", "lastUpdateTime",
                "installerPackageName"):
        m = re.search(rf"\b{key}=(\S+)", out)
        if m:
            print(f"{key}: {m.group(1)}")


def cmd_current(a):
    pkg, act = foreground()
    print(f"{pkg}/{act}" if pkg else "unknown")


def cmd_termux(a):
    sh(q("am", "start", "-n", TERMUX_ACTIVITY), check=False)
    mark_stale("phone termux")
    print("Brought Termux to the front so the user can see the chat.")


def cmd_ls(a):
    r = sh(q("ls", "-la", a.path), check=False)
    print((r.stdout + r.stderr).strip())


def cmd_mkdir(a):
    _check_remote(a.path)
    sh(q("mkdir", "-p", a.path))
    print(f"Created {a.path}")


def _check_remote(path: str):
    p = path if path.endswith("/") else path + "/"
    if ".." in path.split("/") or not p.startswith(PUSH_ROOTS):
        die(f"Only shared storage can be written ({', '.join(PUSH_ROOTS)}), not {path}")


def cmd_push(a):
    _check_remote(a.remote)
    if not Path(a.local).exists():
        die(f"{a.local} doesn't exist")
    r = run(["push", a.local, a.remote], timeout=3600, check=False)
    out = (r.stdout + r.stderr).strip()
    if r.returncode != 0:
        die(f"push failed: {out}")
    print(out.splitlines()[-1] if out else f"Pushed {a.local} -> {a.remote}")


def cmd_pull(a):
    dest = Path(a.local) if a.local else DOWNLOADS / "pulled"
    if not a.local:
        dest.mkdir(parents=True, exist_ok=True)
    r = run(["pull", a.remote, str(dest)], timeout=3600, check=False)
    out = (r.stdout + r.stderr).strip()
    if r.returncode != 0:
        die(f"pull failed: {out}")
    print(f"{out.splitlines()[-1] if out else 'Pulled'}\nSaved under: {dest}")


def sniff(path: Path) -> str:
    with open(path, "rb") as f:
        head = f.read(512)
    if head.startswith(b"PK"):
        try:
            with zipfile.ZipFile(path) as z:
                names = z.namelist()
        except zipfile.BadZipFile:
            return "damaged ZIP (download may be incomplete)"
        if "AndroidManifest.xml" in names:
            return "Android app (APK)"
        if any(n.lower().endswith(".apk") for n in names):
            return "bundle of split APKs (install it with: phone install <file>)"
        return f"ZIP archive ({len(names)} files)"
    if head.startswith(b"7z\xbc\xaf\x27\x1c"):
        return "7-Zip archive"
    if head.startswith(b"Rar!"):
        return "RAR archive"
    if head.startswith(b"\x1f\x8b"):
        return "gzip archive"
    low = head.lstrip(b"\xef\xbb\xbf \t\r\n").lower()
    if low.startswith((b"<!doctype", b"<html", b"<?xml", b"<head")):
        return ("WEB PAGE, not a file. The link probably points to a download page; "
                "find the direct file link instead")
    try:
        head.decode("utf-8")
        return "text file"
    except UnicodeDecodeError:
        return "unknown file type"


def _human(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{int(n)} B"
        n /= 1024
    return f"{n:.1f} GB"


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def cmd_download(a):
    u = urlparse(a.url)
    if u.scheme not in ("http", "https"):
        die("Only http(s) links can be downloaded.")
    if shutil.which("curl") is None:
        die("curl is not installed. Run setup/setup.sh.")
    DOWNLOADS.mkdir(parents=True, exist_ok=True)
    tmp = Path(tempfile.mkdtemp(prefix=".dl-", dir=DOWNLOADS))
    base = ["curl", "-fsSL", "--retry", "3", "--connect-timeout", "20"]
    if a.name:
        name = Path(a.name).name
        cmd = base + ["-o", name, "-w", "%{url_effective}", a.url]
    else:
        cmd = base + ["-J", "-O", "-w", "%{url_effective}", a.url]
    r = subprocess.run(cmd, cwd=tmp, capture_output=True, text=True)
    files = [p for p in tmp.iterdir() if p.is_file()]
    if r.returncode != 0 or not files:
        shutil.rmtree(tmp, ignore_errors=True)
        die(f"Download failed: {r.stderr.strip() or 'curl exit code %d' % r.returncode}")
    src = files[0]
    dest = DOWNLOADS / src.name
    if dest.exists():
        dest.unlink() if dest.is_file() else shutil.rmtree(dest)
    src.rename(dest)
    shutil.rmtree(tmp, ignore_errors=True)
    if u.scheme == "http":
        print("warning: downloaded over plain http (not encrypted).")
    print(f"Saved: {dest}")
    print(f"Size: {_human(dest.stat().st_size)}")
    print(f"Type: {sniff(dest)}")
    print(f"SHA-256: {sha256(dest)}")
    print(f"From: {r.stdout.strip() or a.url}")


def cmd_unpack(a):
    src = Path(a.archive)
    if not src.is_file():
        die(f"{src} doesn't exist")
    dest = Path(a.to) if a.to else src.with_name(src.stem + "-unpacked")
    dest.mkdir(parents=True, exist_ok=True)
    kind = sniff(src)
    if kind.startswith(("Android app", "bundle", "ZIP")):
        with zipfile.ZipFile(src) as z:
            z.extractall(dest)  # zipfile strips absolute paths and ".." parts
    elif kind.startswith(("7-Zip", "RAR", "gzip")):
        tool = shutil.which("7zz") or shutil.which("7z")
        if not tool:
            die("No 7-Zip tool installed. Run setup/setup.sh.")
        r = subprocess.run([tool, "x", "-y", f"-o{dest}", str(src)], capture_output=True, text=True)
        if r.returncode != 0:
            die(f"Unpacking failed: {(r.stderr or r.stdout).strip()[-500:]}")
    else:
        die(f"Can't unpack this ({kind}).")
    files = sorted(p for p in dest.rglob("*") if p.is_file())
    print(f"Unpacked to: {dest}  ({len(files)} files)")
    for p in files[:60]:
        print(f"  {p.relative_to(dest)}  ({_human(p.stat().st_size)})")
    if len(files) > 60:
        print(f"  … and {len(files) - 60} more")


INSTALL_HINTS = {
    "INSTALL_FAILED_DEPRECATED_SDK_VERSION": "This app was built for a very old Android version, which "
        "Android 14+ blocks. If the user agrees, retry with --allow-old-sdk.",
    "INSTALL_FAILED_UPDATE_INCOMPATIBLE": "A version of this app signed by someone else is already "
        "installed (e.g. Play Store build vs GitHub build). Replacing it means uninstalling first, "
        "which DELETES its data. Ask the user.",
    "INSTALL_FAILED_VERSION_DOWNGRADE": "A newer version is already installed. To go back, retry "
        "with --downgrade (ask the user first).",
    "INSTALL_FAILED_NO_MATCHING_ABIS": "Wrong CPU type for this tablet. Check `phone info` and pick "
        "the matching APK (usually arm64-v8a).",
    "INSTALL_FAILED_INSUFFICIENT_STORAGE": "Not enough free space on the tablet.",
    "INSTALL_FAILED_USER_RESTRICTED": "The tablet blocked or asked about the install. Check the "
        "screen; some brands need 'Install via USB' allowed in Developer options.",
    "INSTALL_PARSE_FAILED": "The file isn't a valid APK. The download may be incomplete or wrong.",
    "INSTALL_FAILED_INVALID_APK": "The file isn't a valid APK. The download may be incomplete or wrong.",
    "INSTALL_FAILED_MISSING_SPLIT": "This app comes in several pieces. Install all its APK files together.",
}


def cmd_install(a):
    apks, obbs = [], []
    work = None
    for f in map(Path, a.files):
        if not f.is_file():
            die(f"{f} doesn't exist")
        suffix = f.suffix.lower()
        if suffix == ".apk":
            apks.append(f)
        elif suffix in (".xapk", ".apks", ".apkm", ".zip"):
            work = work or Path(tempfile.mkdtemp(prefix=".bundle-", dir=DOWNLOADS))
            try:
                with zipfile.ZipFile(f) as z:
                    names = z.namelist()
                    if "AndroidManifest.xml" in names:
                        apks.append(f)
                        continue
                    for n in names:
                        if n.lower().endswith(".apk"):
                            apks.append(Path(z.extract(n, work)))
                        elif n.lower().endswith(".obb"):
                            obbs.append((n, Path(z.extract(n, work))))
            except zipfile.BadZipFile:
                die(f"{f.name} isn't a readable bundle (it may be encrypted or damaged).")
        else:
            die(f"Don't know how to install a {suffix or 'file without extension'} file.")
    if not apks:
        die("No APK found to install.")
    before = set(packages(third_party=False))
    flags = ["-r"] + (["-d"] if a.downgrade else []) + \
        (["--bypass-low-target-sdk-block"] if a.allow_old_sdk else [])
    verb = "install" if len(apks) == 1 else "install-multiple"
    r = run([verb, *flags, *map(str, apks)], timeout=900, check=False)
    out = (r.stdout + r.stderr).strip()
    if r.returncode != 0 or "Success" not in out:
        hints = [h for code, h in INSTALL_HINTS.items() if code in out]
        if work:
            shutil.rmtree(work, ignore_errors=True)
        die(f"Install failed:\n{out}" + (f"\nWhat it means: {hints[0]}" if hints else ""))
    for name, path in obbs:
        rel = name[name.lower().index("android/obb/"):] if "android/obb/" in name.lower() else \
            f"Android/obb/{path.name}"
        run(["push", str(path), "/sdcard/" + rel], timeout=3600)
        print(f"Copied game data to /sdcard/{rel}")
    if work:
        shutil.rmtree(work, ignore_errors=True)
    new = sorted(set(packages(third_party=False)) - before)
    print("Installed." + (f" New app: {', '.join(new)}" if new else " (updated an app that was already installed)"))


def cmd_uninstall(a):
    reason = block_reason(a.package, "uninstall")
    if reason:
        die(reason)
    r = run(["uninstall", *(["-k"] if a.keep_data else []), a.package], check=False, timeout=120)
    out = (r.stdout + r.stderr).strip()
    if "Success" not in out:
        die(f"Uninstall failed: {out}")
    print(f"Uninstalled {a.package}" + (" (kept its data)" if a.keep_data else ""))


SPECIAL_GRANTS = {
    "all-files": [("appops", "MANAGE_EXTERNAL_STORAGE")],
    "storage": [("pm", "android.permission.READ_EXTERNAL_STORAGE"),
                ("pm", "android.permission.WRITE_EXTERNAL_STORAGE"),
                ("appops", "MANAGE_EXTERNAL_STORAGE")],
    "install-apps": [("appops", "REQUEST_INSTALL_PACKAGES")],
    "overlay": [("appops", "SYSTEM_ALERT_WINDOW")],
    "notifications": [("pm", "android.permission.POST_NOTIFICATIONS")],
}


def cmd_grant(a):
    reason = block_reason(a.package, "change permissions for")
    if reason:
        die(reason)
    what = a.permission
    steps = SPECIAL_GRANTS.get(what.lower())
    if steps is None:
        perm = what if "." in what else f"android.permission.{what.upper()}"
        steps = [("pm", perm)]
    results = []
    for kind, perm in steps:
        cmd = q("appops", "set", a.package, perm, "allow") if kind == "appops" else \
            q("pm", "grant", a.package, perm)
        r = sh(cmd, check=False)
        err = (r.stdout + r.stderr).strip()
        results.append(f"{perm}: " + ("granted" if r.returncode == 0 and not err else f"not granted ({err[:120]})"))
    print("\n".join(results))


def cmd_sh(a):
    r = sh(" ".join(a.command), check=False, timeout=a.timeout)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    mark_stale("phone shell")
    return r.returncode


def cmd_fix_background(a):
    steps = [
        ("Stop Android from killing Termux's background processes",
         "/system/bin/device_config set_sync_disabled_for_tests persistent; "
         "/system/bin/device_config put activity_manager max_phantom_processes 2147483647; "
         "settings put global settings_enable_monitor_phantom_procs false"),
        ("Exempt Termux from battery optimization", "cmd deviceidle whitelist +com.termux"),
        ("Allow Termux to run in the background",
         "cmd appops set com.termux RUN_ANY_IN_BACKGROUND allow"),
    ]
    for label, cmd in steps:
        r = sh(cmd, check=False)
        status = "done" if r.returncode == 0 else f"skipped ({(r.stderr or r.stdout).strip()[:100]})"
        print(f"{label}: {status}")


# ---------------------------------------------------------------------- parser

def build_parser():
    p = argparse.ArgumentParser(prog="phone", description="See and control an Android device over ADB.")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    def add(name, func, help_):
        sp = sub.add_parser(name, help=help_, description=help_)
        sp.set_defaults(func=func)
        return sp

    add("status", cmd_status, "Is a device connected? Shows model and the app in front.")
    add("info", cmd_info, "Device details: Android version, CPU type (ABI), screen, free storage.")
    sp = add("pair", cmd_pair, "Pair with Wireless debugging (once per device).")
    sp.add_argument("args", nargs="+", metavar="[PORT] CODE",
                    help="the 6-digit code from 'Pair device with pairing code' (the port is found automatically)")
    sp = add("connect", cmd_connect, "Connect to Wireless debugging. Finds the port by itself if omitted.")
    sp.add_argument("port", nargs="?", help="port (or host:port) shown under 'IP address & Port'")

    add("screen", cmd_screen, "List what's on screen as numbered elements you can tap.")
    sp = add("shot", cmd_shot, "Save a screenshot (for games, images, or anything `screen` can't read).")
    sp.add_argument("--out", help="where to save the PNG")

    sp = add("tap", cmd_tap, "Tap by number from `phone screen`, by visible text, or by coordinates.")
    sp.add_argument("target", nargs="+", help='NUMBER | "text" | X Y | --pct X% Y%')
    sp.add_argument("--long", action="store_true", help="long-press instead of tap")
    sp.add_argument("--pct", action="store_true", help="X and Y are percentages of the screen")
    sp.add_argument("--nth", type=int, help="when text matches several elements, pick the Nth (1-based)")
    sp = add("type", cmd_type, "Type text into the focused field (plain characters only).")
    sp.add_argument("text", nargs="*")
    sp.add_argument("--enter", action="store_true", help="press Enter afterwards")
    sp.add_argument("--clear", action="store_true", help="delete the field's current text first")
    sp = add("key", cmd_key, "Press keys: back, home, enter, recents, tab, del, up, down, ...")
    sp.add_argument("keys", nargs="+")
    sp = add("scroll", cmd_scroll, "Scroll to see more content in a direction.")
    sp.add_argument("direction", choices=["down", "up", "left", "right"])
    sp.add_argument("--at", type=int, help="scroll inside element NUMBER from `phone screen`")
    sp.add_argument("--amount", type=float, default=1.0, help="0.1 to 1.0 (default 1.0)")
    sp = add("swipe", cmd_swipe, "Swipe between two points.")
    sp.add_argument("coords", nargs=4, type=int, metavar=("X1", "Y1", "X2", "Y2"))
    sp.add_argument("--ms", type=int, default=400, help="duration in milliseconds")
    sp = add("wait", cmd_wait, "Wait until text appears (or disappears) on screen.")
    sp.add_argument("text")
    sp.add_argument("--timeout", type=int, default=30, help="seconds (default 30)")
    sp.add_argument("--gone", action="store_true", help="wait for the text to disappear instead")

    sp = add("open", cmd_open, "Open an installed app by package name.")
    sp.add_argument("package")
    sp = add("url", cmd_url, "Open a web link (or market:// Play Store link) on the device.")
    sp.add_argument("url")
    sp = add("apps", cmd_apps, "List installed apps (user-installed only unless --all).")
    sp.add_argument("filter", nargs="?")
    sp.add_argument("--all", action="store_true")
    sp = add("app", cmd_app, "Show an installed app's version and install dates.")
    sp.add_argument("package")
    add("current", cmd_current, "Show the app and screen (activity) in front.")
    add("termux", cmd_termux, "Bring Termux to the front so the user sees the chat.")

    sp = add("download", cmd_download, "Download a file into downloads/ and show its type and SHA-256.")
    sp.add_argument("url")
    sp.add_argument("--name", help="file name to save as")
    sp = add("unpack", cmd_unpack, "Extract a zip/7z/rar archive and list its contents.")
    sp.add_argument("archive")
    sp.add_argument("--to", help="folder to extract into")
    sp = add("install", cmd_install, "Install APK(s) or an .xapk/.apks/.apkm bundle.  [asks user]")
    sp.add_argument("files", nargs="+")
    sp.add_argument("--downgrade", action="store_true", help="allow installing an older version")
    sp.add_argument("--allow-old-sdk", action="store_true", help="allow apps made for very old Android")
    sp = add("uninstall", cmd_uninstall, "Uninstall an app.  [asks user]")
    sp.add_argument("package")
    sp.add_argument("--keep-data", action="store_true")

    sp = add("ls", cmd_ls, "List a folder on the device.")
    sp.add_argument("path")
    sp = add("mkdir", cmd_mkdir, "Create a folder in shared storage.")
    sp.add_argument("path")
    sp = add("push", cmd_push, "Copy a file or folder to the device's shared storage.  [asks user]")
    sp.add_argument("local")
    sp.add_argument("remote")
    sp = add("pull", cmd_pull, "Copy a file or folder from the device.  [asks user]")
    sp.add_argument("remote")
    sp.add_argument("local", nargs="?")
    sp = add("grant", cmd_grant, "Grant a permission: all-files, storage, install-apps, overlay, "
             "notifications, or an android.permission name.  [asks user]")
    sp.add_argument("package")
    sp.add_argument("permission")
    sp = add("shell", cmd_sh, "Run a raw command in the device shell.  [asks user]")
    sp.add_argument("command", nargs=argparse.REMAINDER)
    sp.add_argument("--timeout", type=int, default=120)
    add("fix-background", cmd_fix_background,
        "One-time setup: stop Android from killing Termux in the background.  [asks user]")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        rc = args.func(args) or 0
    except PhoneError as e:
        print(f"error: {e}", file=sys.stderr)
        rc = e.code
    except KeyboardInterrupt:
        rc = 130
    sys.exit(rc)


if __name__ == "__main__":
    main()
